---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { site } from '../../data/site';

const title = 'Contact TarkovTools: Corrections & Requests';
const description =
  'Contact TarkovTools: report a wrong stat, request a tool, or ask a question. Corrections with a source get priority and a changelog credit.';

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Contact' },
];
---

<Base title={title} description={description} breadcrumbs={breadcrumbs} canonical="/contact/">
  <div class="wrap-narrow">
    <Breadcrumbs items={breadcrumbs} />

    <h1>Contact</h1>
    <p class="lead">
      Corrections, tool requests, questions. Corrections with a source (screenshot, patch notes, API
      diff) get priority and a changelog credit.
    </p>

    <section class="section">
      <h2 id="email">Email</h2>
      <p><strong>{site.email}</strong></p>
      <p class="small muted">We typically reply within 3 business days.</p>
    </section>

    <section class="section">
      <h2 id="report">Reporting a wrong stat</h2>
      <p>To make a correction fast, include:</p>
      <ul>
        <li>the item and stat you believe is wrong;</li>
        <li>the correct value;</li>
        <li>a source (tarkov.dev value, in-game screenshot, or patch notes).</li>
      </ul>
      <p>
        We verify every report against our data pipeline before changing shipped values, then log it in
        the <a href="/changelog/">changelog</a>.
      </p>
    </section>

    <section class="section">
      <h2 id="feature">Tool requests</h2>
      <p>
        Want a calculator we do not have yet (armor planner, quest item tracker, hideout profit)?
        Tell us the use case; requests that name the mechanics move to the front.
      </p>
    </section>

    <section class="section">
      <h2 id="privacy-note">Privacy</h2>
      <p class="small muted">
        See the <a href="/privacy/">privacy policy</a>. Short version: nothing leaves your browser on tool pages.
      </p>
    </section>
  </div>
</Base>
