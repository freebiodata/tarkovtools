---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ToolCard from '../../components/ToolCard.astro';
import { site } from '../../data/site';

const title = 'All Tools: Tarkov Calculators & Charts | TarkovTools';
const description =
  'Every TarkovTools calculator in one place: ammo chart, penetration calculator, ammo solver. Free, in-browser, no sign-up.';

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'All tools' },
];

const tools = [
  { href: '/penetration-calculator/', title: 'Penetration Calculator', desc: 'Exact penetration chance for any round vs any armor, with durability and shots-to-break.' },
  { href: '/ammo-chart/', title: 'Ammo Chart', desc: 'The full dataset: 175 rounds, damage/pen/armor-dmg/speed, filterable.' },
  { href: '/ammo-solver/', title: 'Ammo Solver', desc: 'Ranks rounds against your expected target armor class: plus leg-meta mode.' },
];

const chooser = [
  ['I keep losing fights against armored players', 'Ammo Solver (set class 5 or 6)'],
  ['I want to understand why my rounds bounce', 'Penetration Calculator + the guide'],
  ['I need raw stats for a spreadsheet', 'Ammo Chart'],
  ['I am hunting unarmored targets / leg meta', 'Ammo Solver (unarmored mode)'],
  ['I wonder if a damaged plate is worth shooting', 'Penetration Calculator (lower the durability)'],
];
---

<Base title={title} description={description} breadcrumbs={breadcrumbs} canonical="/tools/">
  <div class="wrap">
    <Breadcrumbs items={breadcrumbs} />

    <div class="hero">
      <h1>All tools</h1>
      <p class="value-line">
        Three focused ballistics tools, all free and running entirely in your browser.
      </p>
    </div>

    <section class="section" aria-labelledby="list">
      <h2 id="list" class="visually-hidden">Tools</h2>
      <ul class="tool-cards">
        {tools.map((t) => <ToolCard href={t.href} title={t.title} desc={t.desc} badgeClass="badge-amber" />)}
      </ul>
    </section>

    <section class="section" aria-labelledby="chooser">
      <h2 id="chooser">Which tool do I need?</h2>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Your situation</th><th>Start here</th></tr></thead>
          <tbody>
            {chooser.map(([problem, tool]) => (
              <tr><td>{problem}</td><td>{tool}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="section" aria-labelledby="faq-cat">
      <h2 id="faq-cat">Quick answers</h2>
      <div class="faq">
        <details>
          <summary>Are all the tools really free?</summary>
          <div class="faq-body"><p>Yes. No sign-up, no watermark, no caps. The math runs in your browser.</p></div>
        </details>
        <details>
          <summary>How fresh is the data?</summary>
          <div class="faq-body"><p>Snapshot 2026-10-08, with the date shown on the chart page. Patches that change stats ship with changelog entries and updated snapshots.</p></div>
        </details>
        <details>
          <summary>Do the tools store my loadouts?</summary>
          <div class="faq-body"><p>No. Values are processed locally and never transmitted or saved after you close the tab.</p></div>
        </details>
      </div>
    </section>
  </div>
</Base>
