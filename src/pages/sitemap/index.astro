---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { site } from '../../data/site';

const title = 'HTML Sitemap: All Pages on TarkovTools';
const description = 'Every page on TarkovTools in one crawlable list: calculators, guides and site pages.';

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Sitemap' },
];

const toolLinks = [
  ['/penetration-calculator/', 'Penetration Calculator'],
  ['/ammo-chart/', 'Ammo Chart'],
  ['/ammo-solver/', 'Ammo Solver'],
];

const guideLinks = [
  ['/guides/', 'Guides index'],
  ['/guides/penetration-explained/', 'Penetration explained'],
];

const siteLinks = [
  ['/about/', 'About'],
  ['/methodology/', 'Methodology & data sources'],
  ['/contact/', 'Contact'],
  ['/changelog/', 'Changelog'],
  ['/privacy/', 'Privacy policy'],
  ['/terms/', 'Terms of use'],
  ['/tools/', 'All tools'],
];
---

<Base title={title} description={description} breadcrumbs={breadcrumbs} canonical="/sitemap/">
  <div class="wrap-narrow">
    <Breadcrumbs items={breadcrumbs} />

    <h1>HTML sitemap</h1>
    <p class="lead">Everything on TarkovTools, grouped for humans and crawlers alike.</p>

    <section class="section">
      <h2 id="tools">Tools</h2>
      <ul>
        {toolLinks.map(([href, label]) => <li><a href={href}>{label}</a></li>)}
      </ul>
    </section>

    <section class="section">
      <h2 id="guides">Guides</h2>
      <ul>
        {guideLinks.map(([href, label]) => <li><a href={href}>{label}</a></li>)}
      </ul>
    </section>

    <section class="section">
      <h2 id="site-pages">Site</h2>
      <ul>
        {siteLinks.map(([href, label]) => <li><a href={href}>{label}</a></li>)}
      </ul>
    </section>
  </div>
</Base>
