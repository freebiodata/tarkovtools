---
import { site } from '../data/site';
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header class="site-header">
  <div class="wrap">
    <a class="site-logo" href="/" aria-label={`${site.name} home`}>
      <svg class="logo-mark" viewBox="0 0 32 32" fill="none" aria-hidden="true">
        <path d="M4 28 16 4l12 24h-6l-6-12-6 12z" fill="#e8862e" />
        <rect x="12" y="22" width="8" height="3" fill="#e6e8dc" />
      </svg>
      {site.name}
    </a>
    <nav class="site-nav" aria-label="Main navigation">
      <a href="/tools/" aria-current={isActive('/tools') ? 'page' : undefined}>All tools</a>
      <a href="/ammo-chart/" aria-current={isActive('/ammo-chart') ? 'page' : undefined}>Ammo chart</a>
      <a href="/penetration-calculator/" aria-current={isActive('/penetration') ? 'page' : undefined}>Penetration</a>
      <a href="/ammo-solver/" aria-current={isActive('/ammo-solver') ? 'page' : undefined}>Solver</a>
      <a href="/guides/" aria-current={isActive('/guides') ? 'page' : undefined}>Guides</a>
    </nav>
  </div>
</header>
